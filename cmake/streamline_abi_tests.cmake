if(XRFG_BUILD_TESTS AND XRFG_BUILD_LAYER)
    add_executable(xrfg_streamline_abi_tests tests/streamline_abi_tests.cpp src/ingress/streamline_camera.cpp)
    target_include_directories(xrfg_streamline_abi_tests PRIVATE include "${XRFG_DEPENDENCY_ROOT}/Streamline")
    target_link_libraries(xrfg_streamline_abi_tests PRIVATE safetyhook version)
    target_compile_features(xrfg_streamline_abi_tests PRIVATE cxx_std_20)
    target_compile_definitions(xrfg_streamline_abi_tests PRIVATE NOMINMAX WIN32_LEAN_AND_MEAN)
    foreach(kind legacy modern unknown mismatch missing_version)
        add_library(xrfg_sl_fixture_${kind} SHARED tests/streamline_abi_fixture.cpp)
        if(NOT kind STREQUAL "missing_version")
            target_sources(xrfg_sl_fixture_${kind} PRIVATE tests/streamline_abi_fixture.rc)
        endif()
        target_include_directories(xrfg_sl_fixture_${kind} PRIVATE include "${XRFG_DEPENDENCY_ROOT}/Streamline")
        target_compile_features(xrfg_sl_fixture_${kind} PRIVATE cxx_std_20)
        set_target_properties(xrfg_sl_fixture_${kind} PROPERTIES OUTPUT_NAME "sl.interposer" RUNTIME_OUTPUT_DIRECTORY "${CMAKE_BINARY_DIR}/streamline-fixtures/${kind}" ARCHIVE_OUTPUT_DIRECTORY "${CMAKE_BINARY_DIR}/streamline-fixtures/${kind}")
        set(legacy 0)
        set(major 2)
        set(supported no)
        if(kind STREQUAL "legacy")
            set(legacy 1)
            set(major 1)
            set(supported yes)
        elseif(kind STREQUAL "modern")
            set(supported yes)
        elseif(kind STREQUAL "unknown")
            set(major 99)
        elseif(kind STREQUAL "mismatch")
            set(major 1)
        endif()
        target_compile_definitions(xrfg_sl_fixture_${kind} PRIVATE FIXTURE_LEGACY=${legacy} FIXTURE_MAJOR=${major})
        if(legacy)
            set(call_abi 1)
        else()
            set(call_abi 2)
        endif()
        add_test(NAME xrfg_streamline_abi_${kind} COMMAND xrfg_streamline_abi_tests "$<TARGET_FILE:xrfg_sl_fixture_${kind}>" "${call_abi}" "${supported}")
    endforeach()
endif()
