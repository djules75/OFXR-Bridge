foreach(argument TEST_EXE PROVIDER DESTINATION)
    if(NOT DEFINED ${argument})
        message(FATAL_ERROR "Missing ${argument}")
    endif()
endforeach()
file(MAKE_DIRECTORY "${DESTINATION}")
file(COPY_FILE "${TEST_EXE}" "${DESTINATION}/kcd-quality.exe" ONLY_IF_DIFFERENT)
file(COPY_FILE "${PROVIDER}" "${DESTINATION}/PDAFWPlugin.dll" ONLY_IF_DIFFERENT)
file(WRITE "${DESTINATION}/RealVR.ini" "[KCD2]\nWorldScale=1.0\n")
execute_process(COMMAND "${DESTINATION}/kcd-quality.exe" "${DESTINATION}/PDAFWPlugin.dll"
    WORKING_DIRECTORY "${DESTINATION}" RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 80)
message("${output}${error}")
if(NOT result EQUAL 0)
    message(FATAL_ERROR "Actual KCD full shader/provider quality regression failed (${result})")
endif()
