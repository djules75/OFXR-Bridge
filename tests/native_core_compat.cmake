cmake_minimum_required(VERSION 3.24)
foreach(required TEST_EXE FORWARDER PROVIDER LEGACY_PROVIDER)
    if(NOT DEFINED ${required} OR NOT EXISTS "${${required}}")
        message(FATAL_ERROR "Missing ${required}: ${${required}}")
    endif()
endforeach()
if(NOT DEFINED WORK_ROOT)
    message(FATAL_ERROR "Missing WORK_ROOT")
endif()
string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef nonce)
set(run "${WORK_ROOT}/${nonce}")
file(MAKE_DIRECTORY "${run}")
file(COPY "${TEST_EXE}" "${FORWARDER}" "${PROVIDER}" DESTINATION "${run}")
get_filename_component(exe_name "${TEST_EXE}" NAME)
execute_process(COMMAND "${CMAKE_COMMAND}" -E env XRFG_TEST_GPU_TRACE=1 XRFG_TEST_NATIVE_DLSSG_VERBOSE=1
    "${run}/${exe_name}" native-dlssg-core-compat "${LEGACY_PROVIDER}"
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
file(WRITE "${run}/result.log" "${output}${error}")
message("${output}${error}")
if(NOT result EQUAL 0)
    message(FATAL_ERROR "Core compatibility GPU regression failed: ${result}; ${run}")
endif()
