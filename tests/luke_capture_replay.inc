 auto module=LoadLibraryA(dll);require(module,"replayprovider");auto init=reinterpret_cast<xrfg::InitDeviceFn>(::GetProcAddress(module,"InitDevice"));auto createbuffers=reinterpret_cast<xrfg::InitFrameWarpFn>(::GetProcAddress(module,"InitFrameWarp"));auto evaluate=reinterpret_cast<xrfg::EvaluateFrameWarpFn>(::GetProcAddress(module,"EvaluateFrameWarp"));require(init&&createbuffers&&evaluate,"replayproviderABI");
 xrfg::DeviceParams dp;dp.d3d12_device=device.Get();dp.d3d12_queue=queue.Get();auto renderer=init(dp);require(renderer,"replayrenderer");auto create=reinterpret_cast<xrfg::CreateTextureFn>((*reinterpret_cast<void***>(renderer))[xrfg::kCreateTextureSlot]);
 xrfg::FrameWarpInitParams bp;bp.hmd_width=W;bp.hmd_height=H;auto eyes=createbuffers(bp);
 ComPtr<ID3D12CommandAllocator> allocator;ComPtr<ID3D12GraphicsCommandList> list;check(device->CreateCommandAllocator(D3D12_COMMAND_LIST_TYPE_DIRECT,IID_PPV_ARGS(&allocator)),"replayallocator");check(device->CreateCommandList(0,D3D12_COMMAND_LIST_TYPE_DIRECT,allocator.Get(),nullptr,IID_PPV_ARGS(&list)),"replaylist");check(list->Close(),"replayclose");
 ComPtr<ID3D12Fence> fence;check(device->CreateFence(0,D3D12_FENCE_FLAG_NONE,IID_PPV_ARGS(&fence)),"replayfence");HANDLE event=CreateEventW(nullptr,FALSE,FALSE,nullptr);UINT64 value{};
 auto submit=[&]{check(list->Close(),"replayrecordclose");ID3D12CommandList* ls[]{list.Get()};queue->ExecuteCommandLists(1,ls);check(queue->Signal(fence.Get(),++value),"replaysignal");check(fence->SetEventOnCompletion(value,event),"replayevent");require(WaitForSingleObject(event,10000)==WAIT_OBJECT_0,"replaytimeout");};
 auto begin=[&]{check(allocator->Reset(),"replayallocatorreset");check(list->Reset(allocator.Get(),nullptr),"replaylistreset");};
 auto buffer=[&](UINT64 size,D3D12_HEAP_TYPE type) {D3D12_HEAP_PROPERTIES heap{};heap.Type=type;D3D12_RESOURCE_DESC d{};d.Dimension=D3D12_RESOURCE_DIMENSION_BUFFER;d.Width=size;d.Height=d.DepthOrArraySize=d.MipLevels=d.SampleDesc.Count=1;d.Layout=D3D12_TEXTURE_LAYOUT_ROW_MAJOR;ComPtr<ID3D12Resource> out;check(device->CreateCommittedResource(&heap,D3D12_HEAP_FLAG_NONE,&d,type==D3D12_HEAP_TYPE_UPLOAD?D3D12_RESOURCE_STATE_GENERIC_READ:D3D12_RESOURCE_STATE_COPY_DEST,nullptr,IID_PPV_ARGS(&out)),"replaybuffer");return out;};
 auto upload=[&](const Row& row,xrfg::TextureDesc target) {auto raw=bytes(dir/row.at("file"));const auto desc=target.texture->GetDesc();require(desc.Width==std::stoul(row.at("width"))&&desc.Height==std::stoul(row.at("height")),"replaydimensions");D3D12_PLACED_SUBRESOURCE_FOOTPRINT fp{};UINT64 size{};device->GetCopyableFootprints(&desc,0,1,0,&fp,nullptr,nullptr,&size);auto b=buffer(size,D3D12_HEAP_TYPE_UPLOAD);void* mapped{};check(b->Map(0,nullptr,&mapped),"replayuploadmap");const auto pitch=std::stoul(row.at("row_pitch")),rowbytes=std::stoul(row.at("row_bytes"));for(unsigned y=0;y<desc.Height;++y)std::memcpy(static_cast<char*>(mapped)+fp.Offset+y*fp.Footprint.RowPitch,raw.data()+y*pitch,rowbytes);b->Unmap(0,nullptr);begin();auto before=transition(target.texture,target.initial_state,D3D12_RESOURCE_STATE_COPY_DEST);list->ResourceBarrier(1,&before);D3D12_TEXTURE_COPY_LOCATION from{},to{};from.pResource=b.Get();from.Type=D3D12_TEXTURE_COPY_TYPE_PLACED_FOOTPRINT;from.PlacedFootprint=fp;to.pResource=target.texture;to.Type=D3D12_TEXTURE_COPY_TYPE_SUBRESOURCE_INDEX;list->CopyTextureRegion(&to,0,0,0,&from,nullptr);std::swap(before.Transition.StateBefore,before.Transition.StateAfter);list->ResourceBarrier(1,&before);submit();};
 xrfg::TextureDesc depth,motion;depth.type=xrfg::Depth;const auto dr=image(1,"afw_plugin_input_depth");unsigned gw=std::stoul(dr.at("width")),gh=std::stoul(dr.at("height"));require(create(renderer,gw,gh,DXGI_FORMAT_R32_FLOAT,D3D12_RESOURCE_STATE_COMMON,depth,false),"replaydepth");require(create(renderer,gw,gh,DXGI_FORMAT_R16G16_FLOAT,D3D12_RESOURCE_STATE_COMMON,motion,false),"replaymotion");upload(dr,depth);upload(image(1,"afw_plugin_input_mv"),motion);
 for(unsigned n=0;n<4;++n) {
  const unsigned frame=n<2?1:n-1;const auto& row=c[n==0||n==2?0:1];const unsigned eye=n<2?unsigned(std::stoul(c[0].at("source_eye")))^(n&1):unsigned(std::stoul(row.at("source_eye")));
  auto input=eyes.eye_frame_buffers[eye];input.depth=depth;input.motion_vectors=motion;
  const auto stage=n==0?"afw_prior_source_eye_color":n==1?"afw_prior_peer_eye_color":"afw_source_color";
