  if(n==3&&std::string_view(variant)=="half"){ep.motion_scale[0]*=.5F;ep.motion_scale[1]*=.5F;}
  {xrfg::AfwProviderCopyScope scope(renderer);evaluate(ep);}
  require(ep.output_eye_frame_buffer&&ep.output_eye_frame_buffer->color.texture,"replayoutput");auto out=ep.output_eye_frame_buffer->color;
  const auto desc=out.texture->GetDesc();D3D12_PLACED_SUBRESOURCE_FOOTPRINT fp{};UINT64 size{};device->GetCopyableFootprints(&desc,0,1,0,&fp,nullptr,nullptr,&size);auto read=buffer(size,D3D12_HEAP_TYPE_READBACK);
  auto before=transition(out.texture,out.initial_state,D3D12_RESOURCE_STATE_COPY_SOURCE);list->ResourceBarrier(1,&before);D3D12_TEXTURE_COPY_LOCATION from{},to{};from.pResource=out.texture;from.Type=D3D12_TEXTURE_COPY_TYPE_SUBRESOURCE_INDEX;to.pResource=read.Get();to.Type=D3D12_TEXTURE_COPY_TYPE_PLACED_FOOTPRINT;to.PlacedFootprint=fp;list->CopyTextureRegion(&to,0,0,0,&from,nullptr);std::swap(before.Transition.StateBefore,before.Transition.StateAfter);list->ResourceBarrier(1,&before);submit();
  if(n>=2){void* data{};check(read->Map(0,nullptr,&data),"replayread");unsigned green{},count{};double mae{};const auto rr=image(frame,"afw_plugin_returned_eye");auto actual=bytes(dir/rr.at("file"));for(unsigned y=H/4;y<3*H/4;y+=2)for(unsigned x=W/4;x<3*W/4;x+=2){auto* pix=static_cast<unsigned char*>(data)+fp.Offset+y*fp.Footprint.RowPitch+x*4;auto* reference=reinterpret_cast<unsigned char*>(actual.data())+y*std::stoul(rr.at("row_pitch"))+x*4;if(pix[1]>pix[0]+50&&pix[1]>pix[2]+50)++green;++count;for(unsigned k=0;k<3;++k)mae+=std::abs(int(pix[k])-int(reference[k]));}std::cout<<"REPLAY frame="<<frame<<" variant="<<variant<<" green="<<double(green)/count<<" captured_output_MAE="<<mae/(3*count)<<'\n';if(n==3){std::ofstream file(dir/(std::string("replay-")+variant+".rgba"),std::ios::binary);for(unsigned y=0;y<H;++y)file.write(static_cast<const char*>(data)+fp.Offset+y*fp.Footprint.RowPitch,W*4);}read->Unmap(0,nullptr);}
 }
 CloseHandle(event);return 0;
}catch(const std::exception& e){std::cerr<<e.what()<<'\n';return 1;}}
}
