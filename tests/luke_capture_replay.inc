// Offline replay only: no keyboard, installed-game or runtime configuration writes.
namespace replay {
using namespace quality;
using Row=std::map<std::string,std::string>;
std::vector<std::string> split(const std::string& s,char sep) {std::vector<std::string> v;std::istringstream in(s);std::string x;while(std::getline(in,x,sep))v.push_back(x);return v;}
std::vector<Row> tsv(const std::filesystem::path& p) {std::ifstream in(p);require(bool(in),"replay TSV missing");std::string line;std::getline(in,line);auto head=split(line,'\t');std::vector<Row> out;while(std::getline(in,line)){if(line.empty())continue;auto v=split(line,'\t');Row r;for(unsigned i=0;i<std::min(v.size(),head.size());++i)r[head[i]]=v[i];out.push_back(r);}return out;}
xrfg::Matrix4x4 matrix(const Row& r,const char* key) {xrfg::Matrix4x4 m;auto v=split(r.at(key),',');require(v.size()==16,"replay matrix missing");for(unsigned i=0;i<16;++i)m.values[i]=std::stof(v[i]);return m;}
xrfg::CameraData camera(const Row& r) {xrfg::CameraData c;for(auto p:std::initializer_list<std::pair<const char*,xrfg::Matrix4x4*>>{
 {"source_world_to_view",&c.source_world_to_view},{"source_view_to_world",&c.source_view_to_world},{"source_view_to_clip",&c.source_view_to_clip},{"source_clip_to_view",&c.source_clip_to_view},
 {"destination_world_to_view",&c.destination_world_to_view},{"destination_view_to_world",&c.destination_view_to_world},{"destination_view_to_clip",&c.destination_view_to_clip},{"destination_clip_to_view",&c.destination_clip_to_view},
 {"camera_world_to_view",&c.camera_world_to_view},{"camera_view_to_world",&c.camera_view_to_world},{"camera_view_to_clip",&c.camera_view_to_clip},{"camera_clip_to_view",&c.camera_clip_to_view}})*p.second=matrix(r,p.first);return c;}
xrfg::CameraData prior_camera(const Row& r) {
 auto c=camera(r);using namespace xrfg::native_motion_detail;
 const auto get=[](const xrfg::Matrix4x4& m){std::array<float,16>a;std::copy_n(m.values,16,a.begin());return xrfg::native_motion_detail::matrix(a);};
 const auto put=[](const Matrix& a,xrfg::Matrix4x4& m){auto v=values(a);std::copy(v.begin(),v.end(),m.values);};
 auto old=xrfg::native_motion_detail::multiply(xrfg::native_motion_detail::multiply(xrfg::native_motion_detail::multiply(get(c.source_clip_to_view),get(replay::matrix(r,"motion_current_to_previous_same"))),get(c.source_view_to_clip)),get(c.source_world_to_view));
 auto dst=xrfg::native_motion_detail::multiply(xrfg::native_motion_detail::multiply(get(c.destination_world_to_view),get(c.source_view_to_world)),old);Matrix inverse_old{},inverse_dst{};require(inverse(old,inverse_old)&&inverse(dst,inverse_dst),"replay old camera inverse");
 put(old,c.source_world_to_view);put(inverse_old,c.source_view_to_world);put(dst,c.destination_world_to_view);put(inverse_dst,c.destination_view_to_world);return c;
}
int run(const char* dll,const char* directory,const char* variant) {try {
 const std::filesystem::path dir=directory;auto images=tsv(dir/"manifest.tsv"),rows=tsv(dir/"guide-contracts.tsv");std::vector<Row> c;for(auto& r:rows)if(r["stage"]=="afw_evaluate")c.push_back(r);require(c.size()==2,"replay needs2actualevaluations");
 const auto image=[&](unsigned f,const char* stage)->Row {for(auto& r:images)if(r.at("frame")==std::to_string(f)&&r.at("stage")==stage){require(r.at("status")=="0","replay image invalid");return r;}throw std::runtime_error("replay stage missing");};
 const auto first=image(1,"afw_source_color");const unsigned W=std::stoul(first.at("width")),H=std::stoul(first.at("height"));
 ComPtr<ID3D12Device> device;check(D3D12CreateDevice(nullptr,D3D_FEATURE_LEVEL_11_0,IID_PPV_ARGS(&device)),"replaydevice");
