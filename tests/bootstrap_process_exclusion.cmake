file(MAKE_DIRECTORY "${SCRATCH}")
file(COPY "${LAYER}" DESTINATION "${SCRATCH}")
get_filename_component(DLL_NAME "${LAYER}" NAME)
get_filename_component(EXE_NAME "${TEST}" NAME)
file(WRITE "${SCRATCH}/ofxr_bridge.ini" "[ofxr]\nexcluded_processes=${EXE_NAME}\n")
execute_process(COMMAND "${TEST}" "${SCRATCH}/${DLL_NAME}" "${HOST}" excluded RESULT_VARIABLE result)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "Compatible OptiScaler bypassed process exclusion")
endif()
